{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Homicide rate by sex, Malaysia, 2016 to 2022.",
    "subtitle": "Both lines have fallen. The shaded band shows the male-female gap; the 2020 marker anchors the COVID period.",
    "anchor": "start",
    "fontSize": 13,
    "font": "Open Sans",
    "fontWeight": 400,
    "color": "#666",
    "subtitleFontSize": 11,
    "subtitleColor": "#888",
    "subtitleFont": "Open Sans",
    "subtitlePadding": 6
  },
  "width": "container",
  "height": 380,
  "padding": {
    "left": 4,
    "right": 28,
    "top": 8,
    "bottom": 8
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/homicide_by_sex_wide.json"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2015.85,
          2022.15
        ],
        "nice": false
      },
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelFont": "Open Sans",
        "labelColor": "#444",
        "format": "d",
        "domain": false,
        "ticks": false,
        "grid": false,
        "tickCount": 7
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#cfcfcf",
        "opacity": 0.35,
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "male",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.55
            ]
          },
          "title": "Homicide rate per 100,000",
          "axis": {
            "labelFontSize": 11,
            "labelFont": "Open Sans",
            "titleFont": "Open Sans",
            "titleFontSize": 12,
            "titleColor": "#666",
            "titlePadding": 10,
            "grid": true,
            "gridColor": "#eee",
            "domain": false,
            "ticks": false
          }
        },
        "y2": {
          "field": "female"
        }
      }
    },
    {
      "data": {"values": [{"year": 2020}]},
      "mark": {
        "type": "rule",
        "stroke": "#555",
        "strokeWidth": 1,
        "strokeDash": [3, 3],
        "opacity": 0.7
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2.5,
        "color": "#1e3a5f",
        "point": {
          "filled": true,
          "size": 60,
          "color": "#1e3a5f"
        }
      },
      "encoding": {
        "y": {
          "field": "male",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "male",
            "title": "Male rate / 100k",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2.5,
        "color": "#a47e1b",
        "point": {
          "filled": true,
          "size": 60,
          "color": "#a47e1b"
        }
      },
      "encoding": {
        "y": {
          "field": "female",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "female",
            "title": "Female rate / 100k",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2020,
            "y": 0.48,
            "label": "COVID-19 lockdowns"
          },
          {
            "year": 2018,
            "y": 0.42,
            "label": "Male victims"
          },
          {
            "year": 2018,
            "y": 0.05,
            "label": "Female victims"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": 600,
        "font": "Open Sans"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": [
            {
              "test": "datum.label === 'Male victims'",
              "value": "#1e3a5f"
            },
            {
              "test": "datum.label === 'Female victims'",
              "value": "#a47e1b"
            }
          ],
          "value": "#444"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": null,
    "font": "Open Sans"
  }
}
