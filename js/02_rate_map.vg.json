{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Adjust for population and the country looks different.",
    "anchor": "start",
    "offset": 12,
    "fontSize": 13,
    "font": "Open Sans",
    "fontWeight": 400,
    "color": "#666"
  },
  "width": "container",
  "height": 390,
  "padding": {"left": 6, "right": 45, "top": 8, "bottom": 18},
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "projection": {"type": "mercator", "center": [108, 4.0], "scale": 1450},
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#e8f0f4", "stroke": null}
    },
    {
      "data": {"graticule": {"step": [5, 5]}},
      "mark": {"type": "geoshape", "filled": false, "stroke": "#fff", "strokeWidth": 0.7, "strokeOpacity": 0.7}
    },
    {
      "data": {"url": "data/malaysia-states.topojson", "format": {"type": "topojson", "feature": "states"}},
      "transform": [
        {
          "lookup": "properties.Name",
          "from": {
            "data": {"url": "data/analysis_state_2023.json"},
            "key": "state",
            "fields": ["rate_per_100k", "violent_crimes", "population", "rank_by_rate"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#fff", "strokeWidth": 0.7},
      "encoding": {
        "color": {
          "field": "rate_per_100k",
          "type": "quantitative",
          "scale": {"scheme": "blues", "domainMin": 0},
          "legend": {
            "title": "Rate per 100,000 residents",
            "titleFont": "Open Sans",
            "labelFont": "Open Sans",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "orient": "bottom-left",
            "gradientLength": 160,
            "gradientThickness": 10
          }
        },
        "tooltip": [
          {"field": "properties.Name", "title": "State"},
          {"field": "rate_per_100k", "title": "Rate per 100k", "format": ".1f"},
          {"field": "violent_crimes", "title": "Total cases", "format": ","},
          {"field": "population", "title": "Population", "format": ","},
          {"field": "rank_by_rate", "title": "Rank by rate"}
        ]
      }
    },
    {
      "data": {"values": [
        {"lon": 100.0, "lat": 8.3, "label": "Penang: high rate after population"},
        {"lon": 107.5, "lat": 6.8, "label": "Sabah: high count, lower rate"}
      ]},
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Open Sans",
        "color": "#1e3a5f",
        "align": "left",
        "limit": 190
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Open Sans"
  }
}
