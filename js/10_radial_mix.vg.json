{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The shape of Malaysia's 2023 violent crime, in one circle.",
    "subtitle": [
      "Each segment is one crime type; longer arcs mean more cases.",
      "Theft (other) and vehicle theft together dominate the picture — property crime is the country's everyday safety issue."
    ],
    "anchor": "start",
    "fontSize": 13,
    "font": "Open Sans",
    "fontWeight": 400,
    "color": "#666",
    "subtitleFontSize": 11,
    "subtitleColor": "#888",
    "subtitleFont": "Open Sans",
    "subtitlePadding": 6
  },
  "width": "container",
  "height": 420,
  "padding": {"left": 0, "right": 12, "top": 8, "bottom": 8},
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "data": {"url": "data/crime_types_by_year.json"},
  "transform": [
    {"filter": "datum.year === 2023"},
    {
      "aggregate": [{"op": "sum", "field": "total", "as": "cases"}],
      "groupby": ["type_label", "category"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 60,
        "stroke": "#fff",
        "strokeWidth": 2,
        "tooltip": true
      },
      "encoding": {
        "theta": {
          "field": "cases",
          "type": "quantitative",
          "stack": true
        },
        "radius": {
          "field": "cases",
          "type": "quantitative",
          "scale": {"type": "sqrt", "zero": true, "rangeMin": 60, "rangeMax": 180}
        },
        "color": {
          "field": "type_label",
          "type": "nominal",
          "scale": {
            "domain": ["Causing injury", "Murder", "Rape", "Robbery", "Break-in", "Vehicle theft", "Theft (other)"],
            "range": ["#1e3a5f", "#2c5f8a", "#5085b0", "#88aed3", "#a47e1b", "#c9a553", "#e2c98f"]
          },
          "legend": {
            "title": "Crime type",
            "titleFont": "Open Sans",
            "labelFont": "Open Sans",
            "titleFontSize": 11,
            "labelFontSize": 11,
            "orient": "right",
            "symbolType": "square",
            "symbolSize": 120
          }
        },
        "order": {
          "field": "type_label",
          "sort": ["Causing injury", "Murder", "Rape", "Robbery", "Break-in", "Vehicle theft", "Theft (other)"]
        },
        "tooltip": [
          {"field": "type_label", "title": "Crime type"},
          {"field": "category", "title": "Category"},
          {"field": "cases", "title": "Cases (2023)", "format": ","}
        ]
      }
    }
  ],
  "view": {"stroke": null},
  "config": {
    "view": {"stroke": null},
    "background": null,
    "font": "Open Sans"
  }
}
