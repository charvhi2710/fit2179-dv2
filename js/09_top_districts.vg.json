{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Inside the states — the ten districts that record the most violent crime.",
    "subtitle": "2023 cases by police district. Most concentrate in Selangor's urban belt, with single hotspots in Ipoh, Penang and KL.",
    "anchor": "start",
    "fontSize": 13,
    "font": "Open Sans",
    "fontWeight": 400,
    "color": "#666",
    "subtitleFontSize": 11,
    "subtitleColor": "#888",
    "subtitleFont": "Open Sans",
    "subtitlePadding": 6
  },
  "width": "container",
  "height": 340,
  "padding": {"left": 0, "right": 12, "top": 8, "bottom": 8},
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "data": {"url": "data/top10_districts_violent.json"},
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#2c3e50",
        "strokeWidth": 2,
        "tooltip": true
      },
      "encoding": {
        "y": {
          "field": "district",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelFont": "Open Sans",
            "labelColor": "#333",
            "labelPadding": 8,
            "domain": false,
            "ticks": false
          }
        },
        "x": {
          "field": "violent_crimes",
          "type": "quantitative",
          "title": "Violent crime cases (2023)",
          "axis": {
            "labelFontSize": 11,
            "labelFont": "Open Sans",
            "titleFont": "Open Sans",
            "titleFontSize": 12,
            "titleColor": "#666",
            "titlePadding": 10,
            "grid": true,
            "gridColor": "#eee",
            "domain": false,
            "ticks": false,
            "format": ",d"
          }
        },
        "x2": {"value": 0}
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 180,
        "color": "#2c3e50",
        "tooltip": true
      },
      "encoding": {
        "y": {"field": "district", "type": "nominal", "sort": "-x"},
        "x": {"field": "violent_crimes", "type": "quantitative"},
        "tooltip": [
          {"field": "district", "title": "District"},
          {"field": "state", "title": "State"},
          {"field": "violent_crimes", "title": "Violent crime cases", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 10,
        "font": "Open Sans",
        "color": "#666"
      },
      "encoding": {
        "y": {"field": "district", "type": "nominal", "sort": "-x"},
        "x": {"field": "violent_crimes", "type": "quantitative"},
        "text": {"field": "state"}
      }
    },
    {
      "data": {"values": [{"x": 380, "district": "Klang Selatan", "label": "5 of the top 10 sit inside Selangor"}]},
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": 600,
        "font": "Open Sans",
        "color": "#a47e1b"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "district", "type": "nominal", "sort": "-x"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": null,
    "font": "Open Sans"
  }
}
