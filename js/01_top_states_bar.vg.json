{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The biggest cities carry the loudest count.",
    "anchor": "start",
    "offset": 12,
    "fontSize": 13,
    "font": "Open Sans",
    "fontWeight": 400,
    "color": "#666"
  },
  "width": "container",
  "height": 390,
  "padding": {"left": 4, "right": 18, "top": 8, "bottom": 8},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {"url": "data/analysis_state_2023.json"},
  "transform": [
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "violent_crimes", "order": "descending"}]},
    {"filter": "datum.rank <= 6"}
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {"field": "violent_crimes", "order": "descending"},
      "title": null,
      "axis": {
        "labelFontSize": 13,
        "labelFont": "Open Sans",
        "labelPadding": 8,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "violent_crimes",
      "type": "quantitative",
      "title": "Number of cases",
      "scale": {"domain": [0, 3200]},
      "axis": {
        "labelFontSize": 11,
        "labelFont": "Open Sans",
        "titleFont": "Open Sans",
        "titleFontSize": 12,
        "titleColor": "#666",
        "titlePadding": 10,
        "grid": true,
        "gridColor": "#eee",
        "domain": false,
        "ticks": false,
        "format": ",d",
        "tickCount": 4
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "color": "#2c3e50", "tooltip": true, "cornerRadiusEnd": 2},
      "encoding": {
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "violent_crimes", "title": "Violent crime cases", "format": ","},
          {"field": "rank_by_count", "title": "Rank by count"}
        ]
      }
    },
    {
  "data": {
    "values": [
      {
        "state": "Selangor",
        "x": 2050,
        "label": "Selangor: 28% of cases"
      }
    ]
  },
  "mark": {
    "type": "text",
    "align": "left",
    "baseline": "bottom",
    "dx": 0,
    "dy": -28,
    "fontSize": 11,
    "fontStyle": "italic",
    "fontWeight": 600,
    "font": "Open Sans",
    "color": "#6d4f12"
  },
  "encoding": {
    "y": {"field": "state", "type": "nominal"},
    "x": {"field": "x", "type": "quantitative"},
    "text": {"field": "label"}
  }
}
  ],
  "config": {
    "view": {"stroke": null},
    "background": null,
    "font": "Open Sans"
  }
}
